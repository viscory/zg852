#!/bin/sh
set -eu

if ! npm run i18n:check; then
  echo "pre-commit: i18n check failed; fix catalogue/FALLBACK/literal key mismatches before committing." >&2
  exit 1
fi

file="observations.md"

if git diff --cached --quiet -- "$file"; then
  exit 0
fi

if git diff --cached --name-status --diff-filter=D -- "$file" | grep -q '^D'; then
  echo "pre-commit: observations.md must not be deleted" >&2
  exit 1
fi

if ! node scripts/check-observations.mjs; then
  exit 1
fi

exit 0
