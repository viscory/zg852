{
  "name": "zg852",
  "version": "1.0.0",
  "description": "Client-side Hong Kong fair meeting-point finder",
  "main": "src/app.js",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "dev": "vite",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1 --directory public",
    "prepare": "git config core.hooksPath .githooks",
    "build": "vite build && node scripts/finalize.mjs",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev public",
    "pages:deploy": "npm run build && wrangler pages deploy public"
  },
  "keywords": [
    "hong-kong",
    "meeting-point",
    "transit",
    "client-side"
  ],
  "author": "viscory",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide-static": "^1.77.0",
    "vite": "^7.3.8",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.19.0"
  }
}
